     p->trapframe->a0 = syscalls[num]();
+
+    // Lab0: nếu bit thứ num của mask được bật thì in ra tên syscall và giá trị trả về
+    if((p->trace_mask >> num) & 1) {
+      printf("syscall %s -> %d\n", syscall_names[num], (int)p->trapframe->a0);
+    }
   } else {
