+uint64
+sys_trace(void)
+{
+  int mask;
+
+  argint(0, &mask);              // lấy tham số thứ 0 (từ trapframe->a0)
+  myproc()->trace_mask = mask;   // ghi nhớ vào struct proc của tiến trình hiện tại
+  return 0;
+}
